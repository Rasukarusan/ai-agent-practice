# LLM設定（Gemini / OpenAI など）
LLM_API_KEY=your_api_key
LLM_MODEL=gemini-2.5-flash
LLM_THINKING=false
# LLM_BASE_URL=  # 省略可。カスタムエンドポイントを使う場合のみ設定

# Embedding（OpenAI）
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1

# OpenSearch
OPENSEARCH_URL=http://localhost:9200

# mem0 メモリ設定（省略可。OPENAI_API_KEYがあれば自動で有効）
# MEM0_USER_ID=default           # ユーザー識別子
# MEM0_LLM_MODEL=gpt-4.1-nano   # メモリ抽出用LLM
# MEM0_EMBEDDING_MODEL=text-embedding-3-small  # メモリ用Embedding
# MEM0_HISTORY_DB_PATH=memory.db # メモリ履歴DBパス

